# Public Tuki hosts. Values are hostnames without https://
CHAT_HOSTNAME=chat.muzes.xyz
CORE_HOSTNAME=core.muzes.xyz
GATEWAY_HOSTNAME=gateway.muzes.xyz
CDN_HOSTNAME=cdn.muzes.xyz
MEDIA_HOSTNAME=media.muzes.xyz
VOICE_HOSTNAME=voice.muzes.xyz
INVITE_HOSTNAME=invite.muzes.xyz
DEVELOPERS_HOSTNAME=developers.muzes.xyz
SEARCH_HOSTNAME=search.muzes.xyz

# Used by Caddy for certificate notifications
ACME_EMAIL=serwerminecraft508@gmail.com

# Comma-separated platform administrator user IDs.
TUKI_ADMIN_USER_IDS=

# Exact browser origins allowed to call Tuki Core.
TUKI_ALLOWED_ORIGINS=https://chat.muzes.xyz,http://localhost:8494,http://127.0.0.1:8494

# Maximum custom emoji upload size in decimal bytes. The API and file service
# must expose and enforce the same value used by the Tuki frontend.
TUKI_EMOJI_UPLOAD_LIMIT_BYTES=4000000
TUKI_ATTACHMENT_UPLOAD_LIMIT_BYTES=10000000
TUKI_ORBIT_MAX_ATTACHMENT_LIMIT_BYTES=500000000
TUKI_ORBIT_MAX_MONTHLY_UPLOAD_BYTES=50000000000
# Raise Autumn's global ceiling only after upload authorisation is enabled at
# the public CDN reverse proxy. Tuki Core still applies per-account limits.
TUKI_STORAGE_ATTACHMENT_LIMIT_BYTES=10000000

# HotPay Pay by Link. The integration sells 30 days of Tuki Orbit access;
# Pay by Link does not perform automatic recurring charges.
TUKI_HOTPAY_PAYMENT_URL=https://platnosc.hotpay.pl/
TUKI_HOTPAY_RETURN_URL=https://chat.muzes.xyz/orbit?payment=return
TUKI_HOTPAY_ORBIT_PRICE_PLN=22.99
TUKI_HOTPAY_ORBIT_MAX_PRICE_PLN=75.99
TUKI_HOTPAY_ORBIT_MAX_ENABLED=false
TUKI_HOTPAY_ORBIT_DURATION_DAYS=30
TUKI_HOTPAY_ENFORCE_IP_ALLOWLIST=true
TUKI_HOTPAY_NOTIFICATION_IPS=18.197.55.26,3.126.108.86,3.64.128.101,18.184.99.42,3.72.152.155,35.159.7.168
